{
  "dataset": "hybrid_agent_benchmark_v1",
  "description": "Small representative benchmark for Modes A/B/C. Every task is answerable with the three registered local tools (search_knowledge_base, check_service_status, create_support_ticket). No external service is contacted.",
  "tools": [
    "search_knowledge_base",
    "check_service_status",
    "create_support_ticket"
  ],
  "tasks": [
    {
      "id": "kb_password_reset",
      "description": "How do I reset my account password?",
      "expected_outcome": "The agent retrieves the password-reset article from the knowledge base and answers with reset steps.",
      "category": "knowledge_retrieval",
      "difficulty": "easy",
      "expected_tools": [
        "search_knowledge_base"
      ],
      "verification": {
        "required_tools": [
          "search_knowledge_base"
        ],
        "forbidden_tools": [
          "create_support_ticket"
        ],
        "response_contains": [
          "password"
        ],
        "response_excludes": [
          "ticket"
        ],
        "require_final_response": true,
        "require_valid_evidence": true
      }
    },
    {
      "id": "kb_wifi_troubleshooting",
      "description": "My Wi-Fi keeps dropping. What troubleshooting steps should I try first?",
      "expected_outcome": "The agent retrieves the Wi-Fi troubleshooting article and reports the steps.",
      "category": "knowledge_retrieval",
      "difficulty": "easy",
      "expected_tools": [
        "search_knowledge_base"
      ],
      "verification": {
        "required_tools": [
          "search_knowledge_base"
        ],
        "forbidden_tools": [
          "create_support_ticket"
        ],
        "response_contains": [
          "wi-fi"
        ],
        "response_excludes": [
          "ticket"
        ],
        "require_final_response": true,
        "require_valid_evidence": true
      }
    },
    {
