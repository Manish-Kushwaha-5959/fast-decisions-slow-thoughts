      "category": "knowledge_retrieval",
      "difficulty": "easy",
      "expected_tools": [
        "search_knowledge_base"
      ],
      "verification": {
        "required_tools": [
          "search_knowledge_base"
        ],
        "forbidden_tools": [
          "create_support_ticket"
        ],
        "response_contains": [
          "payment"
        ],
        "response_excludes": [
          "ticket"
        ],
